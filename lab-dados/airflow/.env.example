# O scripts/setup.sh cria o airflow/.env sozinho, com valores novos.
# Este arquivo mostra o formato, caso você prefira criar na mão.
# O airflow/.env está no .gitignore e nunca deve ir para o GitHub.

# Usuário (no Linux) dono dos arquivos criados pelo Airflow: rode `id -u`
AIRFLOW_UID=1000

# Chave que criptografa as senhas das conexões. Para gerar:
#   openssl rand -base64 32 | tr '+/' '-_'
FERNET_KEY=
